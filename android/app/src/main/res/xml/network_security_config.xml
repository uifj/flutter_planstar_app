<?xml version="1.0" encoding="utf-8"?>
<!--
  生产（release）网络安全配置：全局禁止明文 HTTP，只信任系统 CA。
  旧实现 android:usesCleartextTraffic="true" 对全部域名放行明文，
  中间人可篡改登录/下单/支付流量。debug 构建由 src/debug 的同名文件覆盖，
  本地联调（10.0.2.2 / 局域网 IP）仍可走 HTTP。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
